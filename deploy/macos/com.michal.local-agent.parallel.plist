<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.michal.local-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/michal/local-agent/.venv/bin/python</string>
        <string>/Users/michal/local-agent/agent_entrypoint.py</string>
        <string>--registry</string>
        <string>/Users/michal/Library/Application Support/local-agent/repositories.json</string>
        <string>--max-workers</string>
        <string>2</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/michal/local-agent</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/michal</string>
        <key>PATH</key>
        <string>/Users/michal/.platformio/penv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/michal/Library/Logs/local-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/michal/Library/Logs/local-agent-error.log</string>
</dict>
</plist>
