{
  "manifest_version": 3,
  "name": "Local Agent Chat Bridge",
  "version": "0.4.0",
  "description": "Schedules hard-bound Local Agent wake-ups: one ChatGPT conversation equals one immutable agent/repository binding.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Local Agent Chat Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "control_protocol.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
