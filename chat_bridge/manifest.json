{
  "manifest_version": 3,
  "name": "Local Agent Chat Bridge",
  "version": "0.5.12",
  "description": "Schedules hard-bound Local Agent wake-ups with optional event-driven task and workflow attention notifications.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Local Agent Chat Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "control_protocol.js",
        "content_retry.js",
        "content.js",
        "spawn_content.js",
        "dom_contract.js",
        "exhaustion_guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120"
}
