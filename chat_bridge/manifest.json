{
  "manifest_version": 3,
  "name": "Local Agent Chat Bridge",
  "version": "0.3.0",
  "description": "Schedules compact Local Agent wake-ups for multiple ChatGPT conversations with conversation-scoped controls.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Local Agent Chat Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["control_protocol.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
