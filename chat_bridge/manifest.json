{
  "manifest_version": 3,
  "name": "Local Agent Chat Bridge",
  "version": "0.8.9",
  "description": "Schedules Local Agent wake-ups as transport only; repository execution authority is validated separately.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Local Agent Chat Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "control_protocol.js",
        "conversation_fabric_protocol.js",
        "content_retry.js",
        "spawn_result_content.js",
        "conversation_fabric_content.js",
        "content.js",
        "dom_contract.js",
        "exhaustion_guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120"
}
